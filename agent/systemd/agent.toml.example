# /etc/tiny-log/agent.toml — bare metal (no Docker)
system_interval_secs = 60
service_interval_secs = 120
docker = false
# Warn line (app "agent") when a disk reaches this % used; error at ≥ 95; 0 = off.
disk_warn_pct = 85

[[disk]]
name = "root"
path = "/"

# [[disk]]
# name = "data"
# path = "/mnt/data"

# Optional service checks — edit/remove as needed
[[service]]
name = "sshd"
kind = "process"
match = "sshd"

# [[service]]
# name = "nginx"
