# /etc/tiny-log/agent.env  (chmod 600)
TINY_LOG_URL=http://127.0.0.1:3006
TINY_LOG_API_KEY=same-as-server
TINY_LOG_HOST_NAME=debian-1
TINY_LOG_DOCKER=false
RUST_LOG=info
# kind = "mysql_status" (dsn_env = "TINY_LOG_MYSQL_DSN"). Unix socket or TCP:
#   mysql://tinylog:PASSWORD@localhost/?socket=/run/mysqld/mysqld.sock
#   mysql://tinylog:PASSWORD@127.0.0.1:3306/
TINY_LOG_MYSQL_DSN=
# Disk warning lines at this % used (0 = off; default 85)
# TINY_LOG_DISK_WARN_PCT=85
